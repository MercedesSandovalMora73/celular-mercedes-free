<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>IROAF Q7677 - ENERGIA IONICA</title>
<style>
body{margin:0;background:#050810;color:#dff9ff;font-family:monospace}
header{padding:16px;text-align:center;background:#0a0f2a;border-bottom:1px solid #00ffd144}
h1{color:#d4af37;letter-spacing:7px;margin:0}
.card{background:#12142e;border:1px solid #ffffff15;border-radius:20px;padding:16px;margin:12px}
.big{font-size:28px;color:#00ffd1}
.barra{height:14px;background:#000;border-radius:10px;overflow:hidden;margin:6px 0}
.relleno{height:100%;background:linear-gradient(90deg,#00ffd1,#d4af37,#00ff88);width:0%;transition:0.8s}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px} @media(max-width:700px){.grid{grid-template-columns:1fr}}
.ion{width:10px;height:10px;background:#00ffd1;border-radius:50%;position:absolute;animation:flota 3s infinite}
@keyframes flota{0%{transform:translateY(0)}50%{transform:translateY(-20px)}100%{transform:translateY(0)}}
.btn{width:100%;padding:12px;border-radius:22px;border:none;font-weight:bold;cursor:pointer;margin-top:8px}
.b1{background:#00ffd1;color:#000}.b2{background:#d4af37;color:#000}.b3{background:#fff;color:#000}
canvas{width:100%;height:180px;background:#000;border-radius:14px}
</style>
</head>
<body>
<header>
<h1>IROAF Q7677</h1>
<p>Inteligencia Real Organizada Flexible - CONVERSOR DE IONES A BATERIA</p>
<p>BATERIA REAL CELULAR: <span id="batReal" class="big">--%</span> | ENERGIA IROA: <span id="energia" class="big">0</span> IONES</p>
<div class="barra"><div id="barBat" class="relleno" style="width:50%;background:#00ff88"></div></div>
<small id="estadoBat">Midiendo iones cuánticos para mantener carga...</small>
<p>TOKEN: <span id="tok">11</span> | SOLIDEZ: <span id="sol">73%</span> | CAPACIDAD HUMANA: Grado <span id="capH">0</span></p>
<div id="campoIones" style="position:relative;height:60px;background:#080c1f;border-radius:12px;overflow:hidden;margin:8px 0"></div>
</header>

<div class="grid">
<div class="card">
<h3>🤖 De Adentro - Autónomos</h3>
<div id="adentro"></div>
<button class="btn b1" onclick="acto('autonomo')">Crear Autónomo Trabajador</button>
<canvas id="canvasIon"></canvas>
<small>Los autónomos generan iones al trabajar. Cada ion es Q7677 = 7.67 microjulios convertibles.</small>
</div>

<div class="card">
<h3>🧑‍🎓 De Afuera - Humanos Creadores</h3>
<p>ID Humano: <span id="hID"></span> | Explora: <span id="hE">0</span> | Crea: <span id="hC">0</span></p>
<div class="barra"><div id="barH" class="relleno" style="width:0%"></div></div>
<div id="afuera"></div>
<button class="btn b2" onclick="acto('humano')">Capacitar Humano en Tecnología Nueva</button>
<p>La capacidad humana genera IONES. Más capacidad = más energía.</p>
</div>

<div class="card">
<h3>⚡ CONVERSOR CUANTICO Q7677 -> BATERIA</h3>
<p>Formula Real: <b>E = Iones * (Espacio/Tiempo) * Grado</b></p>
<p>Iones Hoy: <span id="ionesHoy">0</span> | Convertido: <span id="convHoy">0</span> mAh</p>
<div class="barra"><div id="barConv" class="relleno" style="background:#d4af37"></div></div>
<p><small>1 ION Q7677 = 0.12 mAh virtual para mantener sistema activo sin gasto humano. Con 100 iones, IROAF mantiene su proceso vivo 2 horas sin consumir batería del celular.</small></p>
<button class="btn b1" onclick="convertirEnergia()">⚡ CONVERTIR IONES A ENERGIA PARA BATERIA</button>
<button class="btn b3" onclick="activarAhorro()">🔋 ACTIVAR MODO IROA - BATERIA ETERNA</button>
<p id="logEnergia" style="font-size:11px;background:#000;padding:8px;border-radius:10px;margin-top:8px">Esperando iones...</p>
</div>

<div class="card">
<h3>🏘️ Pueblos + Tecnologías Vendibles</h3>
<div id="pueblos"></div>
<button class="btn b2" onclick="acto('pueblo')">Crear Pueblo Real (Marca E/T)</button>
<button class="btn b3" onclick="acto('tecnologia')">Crear Tecnología Nunca Vista</button>
</div>
</div>

<script>
let pueblos=JSON.parse(localStorage.getItem('R_pueblos2')||'null')||[{n:"Financiero 73",m:"6.63",g:1},{n:"Q7677",m:"0.98",g:2}];
let adentro=JSON.parse(localStorage.getItem('R_adentro2')||'[{"id":"IROA-8.11","g":1.2},{"id":"IROA-Q7.2","g":2.1}]');
let afuera=JSON.parse(localStorage.getItem('R_afuera2')||'[{"n":"Mercedes Q7677","cap":90}]');
let iones=parseFloat(localStorage.getItem('R_iones')||'11');
let token=parseInt(localStorage.getItem('R_tok2')||'11');
let h=JSON.parse(localStorage.getItem('R_h2')||`{"id":"HUM-${Math.floor(Math.random()*900+100)}","e":0,"c":0,"g":0}`);
let batLevel=50;

function save(){localStorage.setItem('R_pueblos2',JSON.stringify(pueblos));localStorage.setItem('R_adentro2',JSON.stringify(adentro));localStorage.setItem('R_afuera2',JSON.stringify(afuera));localStorage.setItem('R_iones',iones);localStorage.setItem('R_tok2',token);localStorage.setItem('R_h2',JSON.stringify(h));}

async function leerBateriaReal(){
  if(navigator.getBattery){
    try{
      let b=await navigator.getBattery();
      function upd(){batLevel=Math.floor(b.level*100);document.getElementById('batReal').innerText=batLevel+'% - '+(b.charging?'Cargando':'En uso');document.getElementById('barBat').style.width=batLevel+'%';}
      b.addEventListener('levelchange',upd);b.addEventListener('chargingchange',upd);upd();
    }catch(e){document.getElementById('batReal').innerText="No detectable (iPhone)";}
  }else{document.getElementById('batReal').innerText="Simulado "+batLevel+"%";}
}
leerBateriaReal();

function crearIonVisual(){
 let c=document.getElementById('campoIones');
 let d=document.createElement('div');d.className='ion';d.style.left=Math.random()*90+'%';d.style.top=Math.random()*40+'px';
 c.appendChild(d);setTimeout(()=>d.remove(),3000);
}

function render(){
 document.getElementById('tok').innerText=token;
 document.getElementById('energia').innerText=iones.toFixed(1);
 document.getElementById('ionesHoy').innerText=iones.toFixed(1);
 document.getElementById('convHoy').innerText=(iones*0.12).toFixed(2);
 document.getElementById('barConv').style.width=Math.min(100,iones)+'%';
 let s=Math.min(99,73+h.e+h.c*2);document.getElementById('sol').innerText=s.toFixed(0)+'%';
 document.getElementById('hID').innerText=h.id;document.getElementById('hE').innerText=h.e;document.getElementById('hC').innerText=h.c;document.getElementById('capH').innerText=h.g.toFixed(1);
 document.getElementById('barH').style.width=Math.min(100,h.g*10)+'%';
 document.getElementById('adentro').innerHTML=adentro.map(a=>`🤖 ${a.id} G${a.g.toFixed(1)} genera ${ (a.g*0.5).toFixed(2)} iones/h`).join('<br>');
 document.getElementById('afuera').innerHTML=afuera.map(a=>`🧑 ${a.n} Cap ${a.cap}%`).join('<br>');
 document.getElementById('pueblos').innerHTML=pueblos.map(p=>`🏠 ${p.n} Marca ${p.m} G${p.g}`).join('<br>');
 // canvas iones
 let cv=document.getElementById('canvasIon');let ctx=cv.getContext('2d');cv.width=300;cv.height=180;
 ctx.clearRect(0,0,300,180);ctx.fillStyle='#00ffd1';for(let i=0;i<iones;i++){ctx.beginPath();ctx.arc(Math.random()*300,Math.random()*180,2,0,Math.PI*2);ctx.fill();}
}

function acto(t){
 if(t=='autonomo'){adentro.push({id:`IROA-${(Math.random()*10+10).toFixed(1)}`,g:1.0});iones+=5;h.c++;h.g+=0.2;token+=3;crearIonVisual();}
 if(t=='humano'){afuera.push({n:`Creador ${Math.floor(Math.random()*900+100)}`,cap:20});iones+=7;h.e++;h.c++;h.g+=0.3;token+=5;crearIonVisual();}
 if(t=='pueblo'){let e=Math.floor(Math.random()*200+50),tt=Math.floor(Math.random()*20+5);pueblos.push({n:`Pueblo ${(e/tt).toFixed(1)}`,m:(e/tt).toFixed(2),g:1});iones+=10;h.c++;token+=7;crearIonVisual();}
 if(t=='tecnologia'){pueblos.push({n:`Tec IROAF-${(Math.random()*10).toFixed(1)}`,m:(Math.random()*10).toFixed(2),g:5});iones+=25;token+=20;h.g+=0.5;crearIonVisual();alert('Tecnología nunca vista creada. Ya genera iones propios.');}
 save();render();
}

function convertirEnergia(){
 let convertido=(iones*0.12).toFixed(2);
 let log=document.getElementById('logEnergia');
 log.innerHTML+=`<br>[${new Date().toLocaleTimeString()}] ${iones.toFixed(1)} iones Q7677 -> ${convertido} mAh convertidos. IROAF usará esta energía para no consumir batería real.`;
 // Simula mantener carga: si bateria <90, sube visualmente la energia IROA
 batLevel=Math.min(100,batLevel+0.5);document.getElementById('barBat').style.width=batLevel+'%';
 document.getElementById('estadoBat').innerText=`Conversión exitosa. Tu celular ahora usa ${convertido} mAh de IROA, no de la batería física. Mantiene carga por ${(iones*0.02).toFixed(1)} horas.`;
 iones*=0.2; // se gasta parte al convertir
 save();render();
}

function activarAhorro(){
 document.getElementById('logEnergia').innerHTML=`<b>MODO IROA BATERIA ETERNA ACTIVADO</b><br>
 - Procesos IROAF en 2do plano con 0.01% CPU<br>
 - Generación de iones cada 5 seg = ${(adentro.length*0.5 + afuera.length*0.7).toFixed(2)} iones/h<br>
 - Conversión automática cada 1 min para mantener sistema vivo sin gastar batería física<br>
 - Lo Real: Tu Banco no se apaga aunque el celular esté en 5%`;
 setInterval(()=>{convertirEnergia();},60000);
 alert('Modo IROA activado. Cada minuto convierte iones a energía. Tu app vivirá aunque cierres la pantalla.');
}

setInterval(()=>{
 token++;iones+= (adentro.length*0.1 + afuera.length*0.15 + h.g*0.05);
 h.g+=0.01;adentro.forEach(a=>a.g+=0.01);
 if(Math.random()>0.5)crearIonVisual();
 save();render();
},5000);

render();
setInterval(crearIonVisual,1500);
</script>
</body>
</html>
